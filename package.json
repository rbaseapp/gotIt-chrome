{
  "name": "gotit-chrome-extension",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Production Manifest V3 extension for capturing words and phrases into GotIt.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "cross-env BUILD_MODE=development node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/verify-build.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
